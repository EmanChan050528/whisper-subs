# Text is stored and checked out with LF on every platform, so Windows'
# core.autocrlf stops warning on every commit. (The code writes files with
# explicit encodings and never depends on the checkout's line endings.)
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch these.
*.png  binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.mp4  binary
